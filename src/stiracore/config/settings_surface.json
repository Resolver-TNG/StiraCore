{
  "version": 1,
  "about": "Settings surface manifest (#468): every setting, whether the settings page can change it, when a saved value takes effect and which environment variable wins. docs/settings-surface.md is rendered from this file; tests/test_settings_surface.py fails on an unclassified field or variable.",
  "classes": {
    "A": "On the settings page (done), or to be put there.",
    "B": "On the settings page with a confirmation (a loosening, a cost or an outside destination).",
    "C": "Not on the settings page; the reason is required.",
    "D": "Needs a decision."
  },
  "ui": {
    "yes": "Changed from the settings page.",
    "partial": "Part of it, or through another field.",
    "no": "Not on the settings page."
  },
  "applies": {
    "next_turn": "From the next chat turn.",
    "restart": "When the server starts again.",
    "immediate": "At once (read each time it is used).",
    "reload": "When the page is opened again.",
    "on_run": "When the command or job runs.",
    "per_field": "Per value; see its own section.",
    "never": "Not applied from the file (the server decides).",
    "none": "Not a setting the server applies (read by the OS, a script, a test or an upstream tool)."
  },
  "reasons": {
    "bootstrap": "Needed before the settings page exists (address, data directory, file paths).",
    "exposure": "Widens who can reach the server; the page must not open it.",
    "secret": "A secret value; the page shows names and whether it is set, never the value.",
    "layer3": "Layer 3+ (identity, protected layers); changed by a person editing the file only.",
    "server_fixed": "The server chooses the value; the file does not apply.",
    "integrity": "Part of the rollback protection of the tool rules (ADR 0010); a person on the host only.",
    "loosening": "The widest loosenings stay a hand edit or a variable (the friction is the safeguard).",
    "adr_0012": "YOLO variables: ADR 0012 keeps them variables; their config twins are under gateway.yolo.",
    "stored_only": "Stored and shown only; nothing uses it yet, so the page does not offer it.",
    "single_choice": "Only one accepted value.",
    "os_provided": "Set by the OS or the shell, read only.",
    "upstream_only": "Read by an upstream tool; Stira ignores it.",
    "dev": "Development or test switch."
  },
  "items": [
