# /etc/stiracore/stira.env (root:root, mode 0600). Read by systemd as root; lines are KEY=value.
# Nothing here is required. With an instance role attached there is NO AWS key to put in this file.
# Keep the defaults for everything that opens a door:
#   - do not set STIRA_HOST / STIRA_ALLOW_REMOTE (the server then binds 127.0.0.1 only)
#   - do not set STIRA_ENABLE_EXEC_TOOLS (exec-class tools stay hidden)
#   - do not set STIRA_SCHEDULER / STIRA_HEARTBEAT unless you have decided to (both off by default)
AWS_REGION=ap-northeast-1
# Only when a name other than localhost / 127.0.0.1 reaches the server through a tunnel:
# STIRA_ALLOWED_HOSTS=stira.internal.example
