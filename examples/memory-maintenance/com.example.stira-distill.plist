<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Daily model-free memory maintenance for StiraCore (docs/memory-maintenance.md, pattern B).
  Replace /Users/YOU/StiraCore with the absolute path of your checkout (launchd does not
  expand ~ or variables). The log directory must exist before the first run (launchd does
  not create it), then:
    mkdir -p -m 700 /Users/YOU/StiraCore/.local
    cp com.example.stira-distill.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.example.stira-distill.plist
  Run once now:  launchctl kickstart gui/$(id -u)/com.example.stira-distill
  Stop for good: launchctl bootout gui/$(id -u)/com.example.stira-distill  (and delete the file)
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.example.stira-distill</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/YOU/StiraCore/examples/memory-maintenance/stira-distill.sh</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>STIRA_ROOT</key>
        <string>/Users/YOU/StiraCore</string>
    </dict>
    <!-- 04:30 local time, every day. A run missed while the Mac sleeps starts on wake. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>
    <key>RunAtLoad</key>
    <false/>
    <!-- Files the job creates are owner-only (63 = octal 077). -->
    <key>Umask</key>
    <integer>63</integer>
    <key>LowPriorityIO</key>
    <true/>
    <key>Nice</key>
    <integer>10</integer>
    <!-- The wrapper's one-line failure message lands here; its JSON log is in the data directory. -->
    <key>StandardErrorPath</key>
    <string>/Users/YOU/StiraCore/.local/stira-distill.launchd.err.log</string>
    <key>StandardOutPath</key>
    <string>/Users/YOU/StiraCore/.local/stira-distill.launchd.out.log</string>
</dict>
</plist>
